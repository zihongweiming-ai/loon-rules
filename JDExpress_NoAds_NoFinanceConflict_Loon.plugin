#!name=京东快递去广告-不冲突修正版
#!desc=修正与京东金融冲突的问题：移除 ms.jr.jd.com、mapi.m.jd.com、京东金融/小金库/白条相关拦截；仅保留京东快递/京东物流和京东广告平台的轻量拦截。若京东金融白条/小金库仍打不开，请确认旧版京东快递去广告插件已关闭。
#!author=ChatGPT
#!date=2026-05-11
#!loon_version=3.2.0

[Rule]
# 京东广告平台/联盟广告，不涉及京东金融核心业务
DOMAIN,dsp-x.jd.com,REJECT
DOMAIN,bdsp-x.jd.com,REJECT
DOMAIN,ads-union.jd.com,REJECT
DOMAIN-SUFFIX,ads.union.jd.com,REJECT
DOMAIN,du.jd.com,REJECT
DOMAIN,u-x.jd.com,REJECT
DOMAIN,img-x.jd.com,REJECT
DOMAIN-SUFFIX,360yield.com,REJECT

[URL Rewrite]
# 京东广告平台 adx
^https?:\/\/b?dsp-x\.jd\.com\/adx\/.* reject-200

# 京东快递/京东物流相关广告、弹窗、推荐位
^https?:\/\/.*\.jdwl\.com\/.*(?:ad|advert|advertise|banner|popup|popbox|splash|launch|startup|marketing|promotion|recommend).* reject-dict
^https?:\/\/.*\.jdl\.com\/.*(?:ad|advert|advertise|banner|popup|popbox|splash|launch|startup|marketing|promotion|recommend).* reject-dict

# api.m.jd.com 只保留明确广告 functionId，不再拦 start/startup，避免误伤京东金融
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(queryMaterialAdverts|getLoadingPicture|getPopUpInfo|adQuery|advertisement|queryAd|appAd|feedAd|deliverLayer|deliveryLayer).* reject-dict

[MITM]
hostname = %APPEND% api.m.jd.com, dsp-x.jd.com, bdsp-x.jd.com, *.jdwl.com, *.jdl.com
