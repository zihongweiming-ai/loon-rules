#!name=京东快递去广告（抓包精确版 v3）
#!desc=2026-09-02 抓包更新：兼容 lop-proxy 双斜杠接口；去开屏、福利弹窗、新人弹窗、京寄卡/PLUS Banner、首页中部营销位；保留寄件、查件、优惠券、小组件帮助和正常资源。
#!author=ChatGPT
#!date=2026-09-02
#!homepage=https://github.com/zihongweiming-ai/loon-rules
#!loon_version=3.2.0

[Script]
# 请求阶段：优先拦截可明确识别的开屏/弹窗，减少闪现与缓存
http-request ^https:\/\/lop-proxy\.jd\.com\/+decision(?:\?.*)?$ requires-body=1,script-path=https://raw.githubusercontent.com/zihongweiming-ai/loon-rules/main/JDExpress_NoAds.js?v=20260902-1,timeout=10,tag=京东快递去广告-Decision请求
http-request ^https:\/\/lop-proxy\.jd\.com\/+(?:queryAppHomePageMarketingRecommendRuleConfigInfo|home\/queryNewPersonSceneDisplayContent)(?:\?.*)?$ requires-body=1,script-path=https://raw.githubusercontent.com/zihongweiming-ai/loon-rules/main/JDExpress_NoAds.js?v=20260902-1,timeout=10,tag=京东快递去广告-弹窗请求

# 响应阶段：营销位精确清理；兼容 / 与 // 两种路径
http-response ^https:\/\/lop-proxy\.jd\.com\/+(?:decision|decisionAggregated|getHomePageFeedCards|queryAppHomePageMarketingRecommendRuleConfigInfo|config\/queryContentListWithPage|queryCmsContentInfo|queryHomeMainInfo|home\/queryNewPersonSceneDisplayContent)(?:\?.*)?$ requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/zihongweiming-ai/loon-rules/main/JDExpress_NoAds.js?v=20260902-1,timeout=10,tag=京东快递去广告-响应清理

[MITM]
hostname = %APPEND% lop-proxy.jd.com
