#!name=平安好车主去广告
#!desc=针对平安好车主首页弹窗、开屏资源、推荐广告位的 Loon 去广告插件。仅处理好车主相关域名，尽量避免影响平安银行/金融/保险功能。若登录、车险、理赔、年检、查违章异常，请先关闭本插件。
#!author=ChatGPT
#!date=2026-05-11
#!loon_version=3.2.0

[Rule]
# 平安好车主常见广告/资源下发域名
DOMAIN,iobs.pingan.com.cn,REJECT

[URL Rewrite]
# 平安好车主首页顶部弹窗/营销弹窗
^https?:\/\/hcz-member\.pingan\.com\.cn\/micro-api\/homepage\/do\/app\/popbox\/getTopPopBox.* reject-dict

# 平安好车主部分开屏/运营资源
^https?:\/\/iobs\.pingan\.com\.cn\/download\/bweb-per-sf-prd\/bweb.* reject-200
^https?:\/\/iobs\.pingan\.com\.cn\/download\/icore-aops-base-dmz-prd\/YourSystemName.* reject-200
^https?:\/\/iobs\.pingan\.com\.cn\/download\/icore-aops-base-dmz-prd\/PersonalCenterHomepageOBM.* reject-200

# 辅助拦截：明显广告、弹窗、活动、营销资源路径
^https?:\/\/hcz-member\.pingan\.com\.cn\/.*(ad|advert|advertise|banner|popup|popbox|marketing|promotion|activity|recommend).* reject-dict
^https?:\/\/iobs\.pingan\.com\.cn\/download\/.*(ad|advert|advertise|banner|popup|popbox|marketing|promotion|activity|recommend).* reject-200

[Script]
# 接口净化：处理广告混在正常 JSON 里的情况
http-response ^https?:\/\/hcz-member\.pingan\.com\.cn\/.* requires-body=true,script-path=https://raw.githubusercontent.com/zihongweiming-ai/loon-rules/main/pingan_car_noads.js,tag=平安好车主接口净化

[MITM]
hostname = %APPEND% hcz-member.pingan.com.cn, iobs.pingan.com.cn
